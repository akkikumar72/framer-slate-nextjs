{
  "name": "framer-template-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@framer-templates/showcase",
    "dev:all": "turbo run dev --parallel",
    "build": "turbo run build",
    "check": "turbo run check",
    "test:routes": "turbo run test:routes",
    "test:browser": "playwright test",
    "verify": "npm run check && npm run build && npm run test:routes && npm run test:browser"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "turbo": "2.10.7"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
