      {
        "tag": "ul",
        "children": [
          {
            "tag": "li",
            "children": [
              {
                "tag": "p",
                "children": [
                  "Access their personal data"
                ]
              }
            ]
          },
          {
            "tag": "li",
            "children": [
              {
                "tag": "p",
                "children": [
                  "Request correction or deletion of their data"
                ]
              }
            ]
          },
          {
            "tag": "li",
            "children": [
              {
                "tag": "p",
                "children": [
                  "Withdraw consent where applicable"
                ]
              }
            ]
          }
        ]
      },
      {
        "tag": "p",
        "children": [
          "Requests should be directed to the website owner using the contact details provided on the site."
        ]
      },
      {
        "tag": "h2",
        "children": [
          "6. Changes to This Policy"
        ]
      },
      {
        "tag": "p",
        "children": [
          "This Privacy Policy may be updated from time to time. Any changes will be reflected on this page with an updated revision date."
        ]
      }
    ]
  },
