{
  "privacy-policy": {
    "title": "Privacy Policy",
    "blocks": [
      {
        "tag": "p",
        "children": [
          {
            "tag": "em",
            "children": [
              "Last updated: 2026"
            ]
          }
        ]
      },
      {
        "tag": "p",
        "children": [
          "At ",
          {
            "tag": "strong",
            "children": [
              "Roco"
            ]
          },
          ", your privacy is important to us. This Privacy Policy explains how information is collected, used, and protected when you use the Roco website template. By using this website, you agree to the practices described below."
