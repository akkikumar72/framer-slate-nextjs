{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_SLATE_URL",
        "NEXT_PUBLIC_GROVIA_URL",
        "NEXT_PUBLIC_FUEL_URL",
        "NEXT_PUBLIC_AGENIO_URL",
        "NEXT_PUBLIC_JAYDEN_URL",
        "NEXT_PUBLIC_SAAZAI_URL",
        "NEXT_PUBLIC_PALMER_URL",
        "NEXT_PUBLIC_TRILLO_URL",
        "NEXT_PUBLIC_PAYBLE_URL",
        "NEXT_PUBLIC_PILAR_URL",
        "NEXT_PUBLIC_DASHFLUENCE_URL"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**"
      ]
    },
    "check": {
      "dependsOn": [
        "^check"
      ],
      "cache": false
    },
    "test:routes": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "persistent": true
    }
  }
}
